# Leap Incentives Gateway — partner credential.
# Server-only. Never expose this to the browser and never prefix it with NEXT_PUBLIC_.
# Copy to .env.local and fill in.
LEAP_API_KEY=your_leap_partner_key_here

# API host. Production: https://api.leap.energy  Staging: https://api.staging.leap.energy
LEAP_API_BASE_URL=https://api.leap.energy

# Optional. Google Maps browser key for address suggestions (Places API (New)).
# Public by design: restrict it by HTTP referrer in the Google Cloud console.
# Leave unset for the manual address form.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Optional. Default lookup mode: address (default) or zip.
# Override per browser with ?lookup=zip, ?lookup=address, or ?lookup=default.
NEXT_PUBLIC_LOOKUP_MODE=address
